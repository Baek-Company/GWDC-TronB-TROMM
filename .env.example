# Copy to .env.local in the repository root. Keep actual values out of Git.
# The illustrative calculator does not require any of the optional keys.
UI_PORT=5173
API_PORT=8787

# Server-side NVIDIA NIM extraction; the code configures openai/gpt-oss-20b.
NVIDIA_API_KEY=

# Optional authentication for external reads.
TRONGRID_API_KEY=
SUN_API_KEY=

# Optional absolute path to a reviewed local JustLend MCP server entry.
JUSTLEND_MCP_ENTRY=

# Optional public Nile wallet address for read-only diagnostics.
NILE_WALLET_ADDRESS=

# Nile approval storage requires 32 random bytes encoded as 64 hex characters.
# Keep the same key and ledger file when recovering pending transactions.
GWDC_APPROVAL_LEDGER_KEY_HEX=
GWDC_APPROVAL_LEDGER_PATH=tmp/nile-approval.sqlite
