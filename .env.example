# Keep real values in .env.local. Never commit .env.local.
DATA_MODE=synthetic
API_PORT=8787

# Optional NVIDIA NIM configuration.
LLM_PROVIDER=nim
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=45000

# Optional TRON data access.
TRONGRID_API_KEY=
MCP_TRONGRID_ENABLED=false

# Keep disabled unless you are intentionally testing Nile with TronLink.
ENABLE_NILE_EXECUTION=false
