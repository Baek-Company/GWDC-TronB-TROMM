#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

NODE_BIN="$(command -v node 2>/dev/null || true)"
if [ ! -x "$NODE_BIN" ]; then
  echo "Node.js를 찾지 못했습니다. Node.js 20 이상을 설치해 주세요." >&2
  exit 1
fi

case "${1:-}" in
  dev)
    if [ ! -f node_modules/tsx/dist/cli.mjs ] || [ ! -f node_modules/vite/bin/vite.js ]; then
      echo "의존성이 없습니다. 먼저 프로젝트에서 패키지를 설치해 주세요." >&2
      exit 1
    fi
    "$NODE_BIN" --watch --import tsx server/index.ts &
    API_PID=$!
    trap 'kill "$API_PID" 2>/dev/null || true' EXIT INT TERM
    "$NODE_BIN" node_modules/vite/bin/vite.js --host 127.0.0.1
    ;;
  doctor)
    exec "$NODE_BIN" --import tsx server/doctor.ts
    ;;
  test)
    exec "$NODE_BIN" node_modules/vitest/vitest.mjs run
    ;;
  typecheck)
    exec "$NODE_BIN" node_modules/typescript/bin/tsc --noEmit -p tsconfig.json
    ;;
  build)
    exec "$NODE_BIN" node_modules/vite/bin/vite.js build
    ;;
  *)
    echo "사용법: sh scripts/run {dev|doctor|test|typecheck|build}" >&2
    exit 2
    ;;
esac
